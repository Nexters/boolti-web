{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "build:stroybook": {
      "outputs": [
        "storybook-static/**"
      ]
    },
    "lint": {},
    "lint:fix": {},
    "preview": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "type-check": {},
    "storybook": {}
  },
  "globalEnv": [
    "VITE_MIXPANEL_TOKEN",
    "VITE_MIXPANEL_DEV_TOKEN",
    "VITE_MIXPANEL_PROD_TOKEN",
    "VITE_MIXPANEL_DEBUG",
    "VITE_MIXPANEL_MODE"
  ]
}
